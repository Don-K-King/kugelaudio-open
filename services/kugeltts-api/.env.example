# GPU selection (UUID or index)
NVIDIA_VISIBLE_DEVICES=all

# Local model mount + ID
KUGEL_MODEL_DIR=../../models
KUGEL_MODEL_ID=/app/models/kugelaudio-0-open

# Allow Hugging Face fallback (set true only if tokenizer/model assets are not local)
KUGEL_ALLOW_HF=false

# Hugging Face cache (optional)
HF_HOME=/app/hf-cache
HF_HOME_HOST=./hf-cache

# Inference settings
TORCH_DTYPE=bfloat16
KUGEL_MAX_NEW_TOKENS=4096
