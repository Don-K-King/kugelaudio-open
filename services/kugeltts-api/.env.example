# GPU selection (UUID or index)
NVIDIA_VISIBLE_DEVICES=GPU-02060075-d528-ac27-7f2d-4959db9057e1
# Optional: force device selection inside the container (match NVIDIA_VISIBLE_DEVICES)
KUGEL_DEVICE=cuda:0

# Model ID (HF repo ID)
KUGEL_MODEL_ID=kugelaudio/kugelaudio-0-open
KUGEL_HF_REPO_ID=kugelaudio/kugelaudio-0-open

# Allow Hugging Face fallback (set true only if tokenizer/model assets are not local)
KUGEL_ALLOW_HF=true

# Hugging Face cache (optional)
HF_HOME=/app/hf-cache

# Inference settings
TORCH_DTYPE=bfloat16
KUGEL_MAX_NEW_TOKENS=4096

# Optional: language registry path (JSON)
# KUGEL_LANGUAGE_REGISTRY_PATH=/app/services/kugeltts-api/config/language_registry.json
